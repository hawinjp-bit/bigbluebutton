{
  "name": "bbb-tenant-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tenant-aware API gateway for BigBlueButton integrations",
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsx watch src/index.ts",
    "keygen": "tsx src/keygen.ts",
    "start": "node dist/index.js",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "LGPL-3.0",
  "dependencies": {
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.15",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
