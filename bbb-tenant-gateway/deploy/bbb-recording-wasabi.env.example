WASABI_SYNC_ENABLED=false
WASABI_SYNC_DRY_RUN=false
RCLONE_BINARY=/usr/bin/rclone
RCLONE_CONFIG=/etc/bbb-recording-wasabi/rclone.conf
RCLONE_REMOTE=wasabi
WASABI_BUCKET=
WASABI_PREFIX=tenants/lunar-one/recordings
TENANT_ID=lunar-one
MEETING_ID_PREFIX=lunar-one:
BBB_PUBLISHED_DIR=/var/bigbluebutton/published
BBB_RAW_DIR=/var/bigbluebutton/recording/raw
