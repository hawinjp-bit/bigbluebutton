[Unit]
Description=BigBlueButton Tenant Gateway
After=network-online.target bbb-web.service
Wants=network-online.target

[Service]
Type=simple
User=bbb-tenant-gateway
Group=bbb-tenant-gateway
WorkingDirectory=/opt/bbb-tenant-gateway/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/default/bbb-tenant-gateway
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
# Recording state (meetings.json, webhooks.json, purge/ tombstones) lives in
# /var/lib/bbb-tenant-gateway; systemd exports it as STATE_DIRECTORY.
StateDirectory=bbb-tenant-gateway
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
